# Copy this file to .env for local secrets. Do not commit the real .env file.

# NVIDIA NIM / build.nvidia.com
NVIDIA_API_KEY=
# Also supported because NVIDIA docs often use this name:
NGC_API_KEY=

# Optional cloud providers
OPENAI_API_KEY=
GEMINI_API_KEY=
CUSTOM_API_KEY=
# Anthropic Claude (Desktop Companion cloud option — sends screenshots when selected)
ANTHROPIC_API_KEY=

# Optional higher Semantic Scholar quota for Phase 1 paper search
SEMANTIC_SCHOLAR_API_KEY=

# Harvester sources
# CORE v3 full-text search (free key from https://core.ac.uk/services/api)
CORE_API_KEY=
# NASA ADS astronomy/physics search (free token from https://ui.adsabs.harvard.edu/user/settings/token)
ADS_API_KEY=
# Contact mail for Crossref "polite pool" and Unpaywall (required for Unpaywall OA resolution)
CROSSREF_MAILTO=
UNPAYWALL_EMAIL=

# Optional web-search providers for grey-source / deep research (Workstream D)
TAVILY_API_KEY=
BRAVE_API_KEY=
SEARXNG_BASE_URL=

# ── Dataset-Quellen (Task-Focused Mode) ──────────────────────────────────
# Kaggle — Competitions + Datasets. Login wie das offizielle kaggle-CLI.
# Auf kaggle.com/account/login einloggen, dann unter Settings → API →
# "Create New Token" lädt kaggle.json; dort stehen username und key.
# Alternativ username+key hier direkt eintragen. .env bleibt gitignored.
KAGGLE_USERNAME=
KAGGLE_KEY=
# Hugging Face Hub — optional, hebt Rate-Limits und gibt Zugriff auf gated
# Datasets (die zusätzlich auf der Hub-Seite freigeschaltet werden müssen).
HF_TOKEN=
