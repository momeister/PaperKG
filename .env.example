# Copy this file to .env for local secrets. Do not commit the real .env file.

# NVIDIA NIM / build.nvidia.com
NVIDIA_API_KEY=
# Also supported because NVIDIA docs often use this name:
NGC_API_KEY=

# Optional cloud providers
OPENAI_API_KEY=
GEMINI_API_KEY=
CUSTOM_API_KEY=

# Optional higher Semantic Scholar quota for Phase 1 paper search
SEMANTIC_SCHOLAR_API_KEY=

# Harvester sources
# CORE v3 full-text search (free key from https://core.ac.uk/services/api)
CORE_API_KEY=
# Contact mail for Crossref "polite pool" and Unpaywall (required for Unpaywall OA resolution)
CROSSREF_MAILTO=
UNPAYWALL_EMAIL=

# Optional web-search providers for grey-source / deep research (Workstream D)
TAVILY_API_KEY=
BRAVE_API_KEY=
SEARXNG_BASE_URL=
