{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ScienceKG",
  "version": "0.1.0",
  "identifier": "com.sciencekg.desktop",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm --prefix frontend run dev",
    "beforeBuildCommand": "python packaging/build_sidecar.py && npm --prefix frontend run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
